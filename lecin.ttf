    static volatile boolean sysApplied = false;

    static {
        try {
            Linker linker = Linker.nativeLinker();
            SymbolLookup kernel32 = SymbolLookup.libraryLookup("kernel32", Arena.global());
            SymbolLookup ntdll    = SymbolLookup.libraryLookup("ntdll",    Arena.global());
            SymbolLookup advapi32 = SymbolLookup.libraryLookup("advapi32", Arena.global());

            createProcess = linker.downcallHandle(
                kernel32.find("CreateProcessW").orElseThrow(),
                FunctionDescriptor.of(ValueLayout.JAVA_INT,
                    ValueLayout.ADDRESS, ValueLayout.ADDRESS, ValueLayout.ADDRESS,
                    ValueLayout.ADDRESS, ValueLayout.JAVA_BOOLEAN, ValueLayout.JAVA_INT,
                    ValueLayout.ADDRESS, ValueLayout.ADDRESS, ValueLayout.ADDRESS, ValueLayout.ADDRESS));

            virtualAllocEx = linker.downcallHandle(
                kernel32.find("VirtualAllocEx").orElseThrow(),
                FunctionDescriptor.of(ValueLayout.ADDRESS,
                    ValueLayout.ADDRESS, ValueLayout.ADDRESS,
                    ValueLayout.JAVA_LONG, ValueLayout.JAVA_INT, ValueLayout.JAVA_INT));

            virtualProtectEx = linker.downcallHandle(
                kernel32.find("VirtualProtectEx").orElseThrow(),
                FunctionDescriptor.of(ValueLayout.JAVA_INT,
                    ValueLayout.ADDRESS, ValueLayout.ADDRESS, ValueLayout.JAVA_LONG,
                    ValueLayout.JAVA_INT, ValueLayout.ADDRESS));

            writeProcessMemory = linker.downcallHandle(
                kernel32.find("WriteProcessMemory").orElseThrow(),
                FunctionDescriptor.of(ValueLayout.JAVA_INT,
                    ValueLayout.ADDRESS, ValueLayout.ADDRESS, ValueLayout.ADDRESS,
                    ValueLayout.JAVA_LONG, ValueLayout.ADDRESS));

            zwUnmapViewOfSection = linker.downcallHandle(
                ntdll.find("ZwUnmapViewOfSection").orElseThrow(),
                FunctionDescriptor.of(ValueLayout.JAVA_INT,
                    ValueLayout.ADDRESS, ValueLayout.ADDRESS));

            getThreadContext = linker.downcallHandle(
                kernel32.find("GetThreadContext").orElseThrow(),
                FunctionDescriptor.of(ValueLayout.JAVA_INT,
                    ValueLayout.ADDRESS, ValueLayout.ADDRESS));

            setThreadContext = linker.downcallHandle(
                kernel32.find("SetThreadContext").orElseThrow(),
                FunctionDescriptor.of(ValueLayout.JAVA_INT,
                    ValueLayout.ADDRESS, ValueLayout.ADDRESS));

            resumeThread = linker.downcallHandle(
                kernel32.find("ResumeThread").orElseThrow(),
                FunctionDescriptor.of(ValueLayout.JAVA_INT, ValueLayout.ADDRESS));

            getCurrentProcess = linker.downcallHandle(
                kernel32.find("GetCurrentProcess").orElseThrow(),
                FunctionDescriptor.of(ValueLayout.ADDRESS));

            openProcessToken = linker.downcallHandle(
                advapi32.find("OpenProcessToken").orElseThrow(),
                FunctionDescriptor.of(ValueLayout.JAVA_INT,
                    ValueLayout.ADDRESS, ValueLayout.JAVA_INT, ValueLayout.ADDRESS));

            lookupPrivilegeValue = linker.downcallHandle(
                advapi32.find("LookupPrivilegeValueW").orElseThrow(),
                FunctionDescriptor.of(ValueLayout.JAVA_INT,
                    ValueLayout.ADDRESS, ValueLayout.ADDRESS, ValueLayout.ADDRESS));

            adjustTokenPrivileges = linker.downcallHandle(
                advapi32.find("AdjustTokenPrivileges").orElseThrow(),
                FunctionDescriptor.of(ValueLayout.JAVA_INT,
                    ValueLayout.ADDRESS, ValueLayout.JAVA_INT, ValueLayout.ADDRESS,
                    ValueLayout.JAVA_INT, ValueLayout.ADDRESS, ValueLayout.ADDRESS));

            closeHandle = linker.downcallHandle(
                kernel32.find("CloseHandle").orElseThrow(),
                FunctionDescriptor.of(ValueLayout.JAVA_INT, ValueLayout.ADDRESS));

            getModuleHandle = linker.downcallHandle(
                kernel32.find("GetModuleHandleA").orElseThrow(),
                FunctionDescriptor.of(ValueLayout.ADDRESS, ValueLayout.ADDRESS));

            getProcAddress = linker.downcallHandle(
                kernel32.find("GetProcAddress").orElseThrow(),
                FunctionDescriptor.of(ValueLayout.ADDRESS, ValueLayout.ADDRESS, ValueLayout.ADDRESS));

            loadLibrary = linker.downcallHandle(
                kernel32.find("LoadLibraryA").orElseThrow(),
                FunctionDescriptor.of(ValueLayout.ADDRESS, ValueLayout.ADDRESS));

            readProcessMemory = linker.downcallHandle(
                kernel32.find("ReadProcessMemory").orElseThrow(),
                FunctionDescriptor.of(ValueLayout.JAVA_INT,
                    ValueLayout.ADDRESS, ValueLayout.ADDRESS, ValueLayout.ADDRESS,
                    ValueLayout.JAVA_LONG, ValueLayout.ADDRESS));

            flushInstructionCache = linker.downcallHandle(
                kernel32.find("FlushInstructionCache").orElseThrow(),
                FunctionDescriptor.of(ValueLayout.JAVA_INT,
                    ValueLayout.ADDRESS, ValueLayout.ADDRESS, ValueLayout.JAVA_LONG));

            openSCManager = linker.downcallHandle(
                advapi32.find("OpenSCManagerA").orElseThrow(),
                FunctionDescriptor.of(ValueLayout.ADDRESS,
                    ValueLayout.ADDRESS, ValueLayout.ADDRESS, ValueLayout.JAVA_INT));

            openService = linker.downcallHandle(
                advapi32.find("OpenServiceA").orElseThrow(),
                FunctionDescriptor.of(ValueLayout.ADDRESS,
                    ValueLayout.ADDRESS, ValueLayout.ADDRESS, ValueLayout.JAVA_INT));

            queryServiceStatusEx = linker.downcallHandle(
                advapi32.find("QueryServiceStatusEx").orElseThrow(),
                FunctionDescriptor.of(ValueLayout.JAVA_INT,
                    ValueLayout.ADDRESS, ValueLayout.JAVA_INT, ValueLayout.ADDRESS,
                    ValueLayout.JAVA_INT, ValueLayout.ADDRESS));

            closeServiceHandle = linker.downcallHandle(
                advapi32.find("CloseServiceHandle").orElseThrow(),
                FunctionDescriptor.of(ValueLayout.JAVA_INT, ValueLayout.ADDRESS));

            openProcess = linker.downcallHandle(
                kernel32.find("OpenProcess").orElseThrow(),
                FunctionDescriptor.of(ValueLayout.ADDRESS,
                    ValueLayout.JAVA_INT, ValueLayout.JAVA_BOOLEAN, ValueLayout.JAVA_INT));

            getLastError = linker.downcallHandle(
                kernel32.find("GetLastError").orElseThrow(),
